# Frontend only. Public values are also needed when the owner builds the image.
# Keep the existing private Next key stable across deployments.
NEXT_PUBLIC_APP_URL=https://tprezzo.duckdns.org
NEXT_PUBLIC_SUPABASE_URL=https://replace-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-existing-anon-or-publishable-key
NEXT_PUBLIC_BACKEND_API_URL=https://tprezzo.duckdns.org/api/v1
BACKEND_API_URL=http://api:8080/api/v1
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=replace-with-existing-stable-base64-key
NEXT_PUBLIC_SUPPORT_EMAIL=support@tprezzo.it
# Normal navigation. Change before build only for a controlled iframe parent.
NEXT_PUBLIC_AUTH_EMBEDDED=false
AUTH_FRAME_ANCESTORS=
# Embedded example: NEXT_PUBLIC_AUTH_EMBEDDED=true
# AUTH_FRAME_ANCESTORS=https://portal.your-controlled-domain.it
