server {
  listen 80;
  listen [::]:80;
  server_name __APP_DOMAIN__;

  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 'ok\n';
  }
  location ^~ /.well-known/acme-challenge/ {
    root /var/www/certbot;
  }
  location / {
    return 301 https://__APP_DOMAIN__$request_uri;
  }
}

server {
  listen 443 ssl;
  listen [::]:443 ssl;
  http2 on;
  server_name __APP_DOMAIN__;

  ssl_certificate /etc/letsencrypt/live/__APP_DOMAIN__/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/__APP_DOMAIN__/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_timeout 1d;
  ssl_session_cache shared:SSL:5m;
  ssl_session_tickets off;

  include /opt/tprezzo/nginx/routes.conf;
}
