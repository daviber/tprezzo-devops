# Server only. Copy to backend.env, chmod 600 and fill from the existing demo.
# Never pass this file as a frontend build secret.
TPREZZO_SUPABASE_URL=https://replace-project-ref.supabase.co
TPREZZO_SUPABASE_PUBLISHABLE_KEY=replace-with-existing-anon-or-publishable-key
TPREZZO_SUPABASE_SERVICE_ROLE_KEY=replace-with-existing-service-role-key
TPREZZO_SUPABASE_AUTH_MODE=remote
TPREZZO_SUPABASE_AUDIENCE=authenticated
TPREZZO_SUPABASE_REQUIRED_ROLE=authenticated
TPREZZO_SUPABASE_CONNECT_TIMEOUT=2s
TPREZZO_SUPABASE_READ_TIMEOUT=10s
TPREZZO_DATA_ACCESS_MODE=rest

TPREZZO_FRONTEND_BASE_URL=https://tprezzo.duckdns.org
TPREZZO_HTTP_CORS_ALLOWED_ORIGINS=https://tprezzo.duckdns.org
TPREZZO_HTTP_MAX_REQUEST_SIZE=25MB

TPREZZO_STRIPE_SECRET_KEY=replace-with-existing-stripe-secret-key
TPREZZO_STRIPE_WEBHOOK_SECRET=replace-with-java-endpoint-signing-secret
TPREZZO_STRIPE_CONNECT_TIMEOUT=2s
TPREZZO_STRIPE_READ_TIMEOUT=10s

# Copy the live values for feature/matching flags and organization allowlist.
TPREZZO_PRICE_CENTRIC_ENABLED=true
TPREZZO_PRICE_CENTRIC_ORGANIZATION_ALLOWLIST=
PRICE_CENTRIC_MATCHING_ENABLED=false
PRICE_CENTRIC_AUTO_THRESHOLD=0.75
PRICE_CENTRIC_AUTO_FIELD_THRESHOLD=0.9
PRICE_CENTRIC_REVIEW_THRESHOLD=0.5
PRICE_CENTRIC_MAX_CANDIDATES_PER_LINE=50
PRICE_CENTRIC_MATCH_QUERY_TIMEOUT_MS=5000
PRICE_CENTRIC_WORKER_CONCURRENCY_PER_ORGANIZATION=1

AI_PROVIDER=aws
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=replace-with-existing-vps-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-existing-vps-secret-access-key
AWS_RETRY_MODE=standard
AWS_MAX_ATTEMPTS=3
AWS_BEDROCK_PRIMARY_MODEL_ID=eu.anthropic.claude-sonnet-4-6
AWS_BEDROCK_FALLBACK_MODEL_ID=eu.anthropic.claude-haiku-4-5-20251001-v1:0
AWS_BEDROCK_ENABLE_STRUCTURED_OUTPUT=true
AWS_BEDROCK_MAX_TOKENS=16384
AWS_BEDROCK_GLOBAL_CONCURRENCY=2
AWS_TEXTRACT_BUCKET=replace-with-existing-textract-bucket
AWS_TEXTRACT_S3_PREFIX=document-ai
AWS_TEXTRACT_POLL_INTERVAL_MS=2000
AWS_TEXTRACT_MAX_WAIT_MS=180000
PRICE_CENTRIC_S3_BUCKET=replace-with-existing-price-centric-bucket
PRICE_CENTRIC_S3_PREFIX=price-centric/uploads

# Async flag/instance id are forced from runtime.env by both Compose services.
# Keep job timeout below lease and graceful shutdown below container grace.
PRICE_CENTRIC_WORKER_CONCURRENCY=4
PRICE_CENTRIC_WORKER_POLL_MS=2000
PRICE_CENTRIC_WORKER_LEASE_SECONDS=600
PRICE_CENTRIC_WORKER_MAX_ATTEMPTS=3
PRICE_CENTRIC_WORKER_JOB_TIMEOUT_SECONDS=300
PRICE_CENTRIC_WORKER_RECOVERY_MS=30000
PRICE_CENTRIC_WORKER_RECOVERY_LIMIT=100
PRICE_CENTRIC_WORKER_BACKOFF_BASE_SECONDS=5
TPREZZO_WORKER_CONCURRENCY=2
TPREZZO_WORKER_QUEUE_CAPACITY=8
TPREZZO_WORKER_SHUTDOWN_TIMEOUT=300s
