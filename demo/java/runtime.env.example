# Compose interpolation only. Keep provider credentials in backend.env.
COMPOSE_PROJECT_NAME=tprezzo-java-demo
APP_DOMAIN=tprezzo.duckdns.org

# Set immutable release tags produced by the owner; never reuse "latest".
API_IMAGE=tprezzo-java-api:replace-with-release-id
WORKER_IMAGE=tprezzo-java-worker:replace-with-release-id
FRONTEND_IMAGE=tprezzo-java-frontend:replace-with-release-id
NGINX_IMAGE=nginx:1.30.5-alpine
CERTBOT_IMAGE=certbot/certbot:v5.8.0
STRIPE_IMAGE=stripe/stripe-cli:v1.51.1
STRIPE_RELAY_ENABLED=true

BACKEND_ENV_FILE=./backend.env
FRONTEND_ENV_FILE=./frontend.env
STRIPE_ENV_FILE=./stripe.env
CERTBOT_CONF_DIR=/opt/tprezzo/devops/demo/certbot/conf
CERTBOT_WWW_DIR=/opt/tprezzo/devops/demo/certbot/www

# Preserve the live installation id when Java takes ownership of the queue.
# Standby never consumes or enables new async jobs. Start profile "async" only
# after draining/stopping every legacy Node consumer of this installation.
INSTANCE_ID=demo-hetzner-eu1
ASYNC_ENABLED=false

START_API_VIRTUAL_THREADS=true
API_JAVA_OPTIONS=-Xms256m -Xmx768m -XX:+UseG1GC -XX:MaxGCPauseMillis=100 -XX:+ExitOnOutOfMemoryError -XX:ActiveProcessorCount=2 -Djava.io.tmpdir=/tmp -Djava.awt.headless=true
WORKER_JAVA_OPTIONS=-Xms256m -Xmx1408m -XX:+UseG1GC -XX:MaxGCPauseMillis=200 -XX:+ExitOnOutOfMemoryError -XX:ActiveProcessorCount=2 -Djava.io.tmpdir=/tmp -Djava.awt.headless=true
FRONTEND_NODE_OPTIONS=--max-old-space-size=640
